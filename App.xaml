<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EventoApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#245B52</Color>
            <Color x:Key="PrimaryDark">#173F39</Color>
            <Color x:Key="Accent">#D9A441</Color>
            <Color x:Key="PageBackground">#F4F7F5</Color>
            <Color x:Key="TextMain">#20312D</Color>
            <Color x:Key="TextMuted">#64736E</Color>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextMain}" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource TextMain}" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="18,14" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
